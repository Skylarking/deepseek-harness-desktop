{
  "name": "codex-pets",
  "version": "2.1.0",
  "description": "Generic Codex-compatible animated pet host for the DSH web client",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/pet.json",
    "assets/spritesheet.webp",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "desktop": {
      "overlay": {
        "entry": "dsh:web",
        "width": 164,
        "height": 164,
        "expandedWidth": 360,
        "expandedHeight": 520
      }
    },
    "settings": {
      "namespaces": [
        "codex-pets"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
